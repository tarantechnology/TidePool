STORAGE_ROOT=storage
MAX_UPLOAD_BYTES=524288000
INFERENCE_ADAPTER=http
# INFERENCE_ADAPTER=http
SAM_AUDIO_SERVICE_URL=http://127.0.0.1:8001/separate
AUDIO_BACKEND=audiosep
# AudioSep defaults; SAM/mock automatically leave conservative suppression off.
# AUDIO_SUPPRESSION=conservative
# AUDIO_SUPPRESSION_STRENGTH=0.9
INFERENCE_TIMEOUT_SECONDS=3600
# Maximum text prompts per processing job; mirrors the audio service's AUDIO_MAX_PROMPTS.
MAX_PROMPTS=8
# Maximum separation passes per /process, /candidates or refine request (audio service `options.passes`).
MAX_PASSES=3
MAX_STEM_BYTES=524288000
FFMPEG_TIMEOUT=600
# Photon integration is intentionally unconfigured until a specific product and API contract are selected.
# Optional natural-language editor planner (never put credentials in frontend variables).
# OPENAI_API_KEY=
# OPENAI_API_KEY_FILE=/path/to/private/key-file
# OPENAI_AGENT_MODEL=gpt-6-luna
# Object detection (vision/ package; local setup: scripts/dev_setup.sh). Weights download to $STORAGE_ROOT/vision.
# VISION_MODEL=yolo26n-seg.pt
# VISION_DEVICE=cpu
# VISION_MAX_SECONDS=30
# VISION_TIMEOUT_SECONDS=600
# Optional SAM object selection on the same private GPU service/tunnel.
# VISION_SERVICE_URL=http://127.0.0.1:8001
