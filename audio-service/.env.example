# Audio inference service (Person 1). All variables are prefixed AUDIO_ to avoid clashing
# with Person 4's backend configuration.
AUDIO_BACKEND=mock            # mock | sam
AUDIO_MODEL_ID=facebook/sam-audio-large
AUDIO_DEVICE=auto             # auto | cuda | cuda:0 | mps | cpu
AUDIO_DTYPE=float32           # float32 | bfloat16 (cuda only)
AUDIO_LOAD_ON_STARTUP=true
AUDIO_PREDICT_SPANS=false     # experimental; leave off until memory/quality evaluation
AUDIO_RERANKING_CANDIDATES=1  # quality retry uses 2; scores express preference, not confidence
# AUDIO_CHUNK_SECONDS=10      # unset: 10 for AUDIO_BACKEND=sam, 0 (whole file) for mock
AUDIO_CHUNK_OVERLAP_SECONDS=2
AUDIO_CHUNK_BATCH=2           # chunk windows per model batch (1-8); k = ~k x activation memory
# AUDIO_CHUNK_WORKERS=        # deprecated alias for AUDIO_CHUNK_BATCH (windows are batched, not threaded)
AUDIO_STEREO_MODE=duplicate   # duplicate | per_channel
AUDIO_MAX_DURATION_SECONDS=600
AUDIO_MAX_INPUT_BYTES=524288000
AUDIO_MAX_PROMPTS=8
AUDIO_MAX_VISUAL_INTERVAL_SECONDS=30  # a visually prompted selection runs as one model window
AUDIO_MEDIA_ROOT=             # e.g. /data (Person 4's STORAGE_ROOT) to allow file:// references
AUDIO_ALLOWED_MEDIA_HOSTS=    # comma-separated hosts allowed for http(s) media references
AUDIO_OUTPUT_ROOT=output      # where stems go when options.return_mode=file
# Real-model knobs (AUDIO_BACKEND=sam); see backends/sam_audio.py for memory figures
# and the recommended configuration per GPU class.
AUDIO_VISUAL_MASK_MODE=keep_object  # keep_object (paper) | notebook (official notebook)
AUDIO_LOAD_SPAN_PREDICTOR=false      # false saves a lot of memory, disables span prediction
AUDIO_LOAD_RANKERS=true             # false saves memory, only matters when reranking > 1
AUDIO_LOAD_VISUAL_RANKER=false        # false saves memory; visual requests use text ranking if available
AUDIO_JUDGE_ONLY=true               # true replaces the text ranker ensemble with Meta's pretrained judge
AUDIO_ODE_METHOD=midpoint
AUDIO_ODE_STEP_SIZE=0.0625          # 2/32
AUDIO_FRAME_SIZE=336                # vision encoder input size
AUDIO_PORT=8001
# HF_TOKEN=hf_...             # required for AUDIO_BACKEND=sam (gated checkpoints)
