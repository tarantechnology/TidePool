# Opt-in Runpod deployment. Use after sequential experiments pass; never run
# an audio model beside a large vision model without measuring the combined load.
HF_HOME=/workspace/.cache/huggingface
TORCH_HOME=/workspace/cache/torch
YOLO_CONFIG_DIR=/workspace/cache/ultralytics
VISION_ADAPTER=sam3.1
VISION_MODEL=/workspace/.cache/huggingface/hub/models--facebook--sam3.1/snapshots/daa63191845a41281374e725f4c9e51c7a824460/sam3.1_multiplex.pt
VISION_CONCEPT=knife
VISION_DEVICE=cuda:0
VISION_MAX_SECONDS=12
VISION_TIMEOUT_SECONDS=1200
AUDIO_BACKEND=sam
AUDIO_MODEL_ID=facebook/sam-audio-small-tv
AUDIO_DEVICE=cuda
AUDIO_DTYPE=float32
AUDIO_VISUAL_BATCH_SIZE=8
AUDIO_LOAD_SPAN_PREDICTOR=false
AUDIO_LOAD_RANKERS=false
AUDIO_PREDICT_SPANS=false
AUDIO_RERANKING_CANDIDATES=1
AUDIO_CHUNK_BATCH=1
AUDIO_CHUNK_SECONDS=4
AUDIO_CHUNK_OVERLAP_SECONDS=1
# Both services must use the same absolute directory for project media.
STORAGE_ROOT=/workspace/SoundCanvas/storage
AUDIO_MEDIA_ROOT=/workspace/SoundCanvas/storage

# Existing public fallback (explicit switch):
# VISION_ADAPTER=yolo
# VISION_MODEL=/workspace/checkpoints/yolo26x-seg.pt
# VISION_IMAGE_SIZE=1280
