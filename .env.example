STORAGE_ROOT=storage
MAX_UPLOAD_BYTES=524288000
INFERENCE_ADAPTER=fake
# INFERENCE_ADAPTER=http
# SAM_AUDIO_SERVICE_URL=http://audio-service:8001/separate
INFERENCE_TIMEOUT_SECONDS=3600
# Maximum text prompts per processing job; mirrors the audio service's AUDIO_MAX_PROMPTS.
MAX_PROMPTS=8
# Maximum separation passes per /process, /candidates or refine request (audio service `options.passes`).
MAX_PASSES=3
MAX_STEM_BYTES=524288000
FFMPEG_TIMEOUT=600
# Photon integration is intentionally unconfigured until a specific product and API contract are selected.
# Optional natural-language editor planner (never put credentials in frontend variables).
# OPENAI_API_KEY=
# OPENAI_API_KEY_FILE=/path/to/private/key-file
# OPENAI_AGENT_MODEL=gpt-6-luna
