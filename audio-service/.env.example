# Audio inference service (Person 1). All variables are prefixed AUDIO_ to avoid clashing
# with Person 4's backend configuration.
AUDIO_BACKEND=mock            # mock | sam
AUDIO_MODEL_ID=facebook/sam-audio-large
AUDIO_DEVICE=auto             # auto | cuda | cuda:0 | mps | cpu
AUDIO_DTYPE=float32           # float32 | bfloat16 (cuda only)
AUDIO_LOAD_ON_STARTUP=true
AUDIO_PREDICT_SPANS=false     # better for short sound events, slower
AUDIO_RERANKING_CANDIDATES=1  # 8 = best quality, ~8x latency and memory
AUDIO_CHUNK_SECONDS=0         # 0 = whole file; e.g. 60 to bound memory on long inputs
AUDIO_CHUNK_OVERLAP_SECONDS=2
AUDIO_STEREO_MODE=duplicate   # duplicate | per_channel
AUDIO_MAX_DURATION_SECONDS=600
AUDIO_MAX_INPUT_BYTES=524288000
AUDIO_MAX_PROMPTS=8
AUDIO_MEDIA_ROOT=             # e.g. /data (Person 4's STORAGE_ROOT) to allow file:// references
AUDIO_ALLOWED_MEDIA_HOSTS=    # comma-separated hosts allowed for http(s) media references
AUDIO_OUTPUT_ROOT=output      # where stems go when options.return_mode=file
AUDIO_PORT=8001
# HF_TOKEN=hf_...             # required for AUDIO_BACKEND=sam (gated checkpoints)
